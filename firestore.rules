rules_version = '2';

// Starting point matching the data model in cuddly-app-directions.md
// (User/Family/Member/BabyProfile/Activity/...). Every family document is
// scoped to its members; nothing is readable/writable by anyone else.
// Review before this ever holds real user data — this has not been audited.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Collection-group query support (#53): the nested match below already
    // secures get/create/update on families/{familyId}/invites/{inviteId},
    // but Firestore's rule-provability check for a `list`/collectionGroup
    // query needs a top-level {path=**} match to recognize and validate it
    // — the nested one alone isn't enough for that operation type.
    match /{path=**}/invites/{inviteId} {
      allow list: if isSignedIn() && request.auth.token.email == resource.data.email;
    }

    match /families/{familyId} {
      allow read, update, delete: if isFamilyMember(familyId);
      allow create: if isSignedIn();

      match /members/{memberId} {
        allow read: if isFamilyMember(familyId);
        // create is intentionally not gated on isFamilyMember: that check
        // requires the member doc to already exist, so the very first
        // member of a new family could never be added otherwise. Creating
        // your own member doc (uid == memberId) is safe regardless.
        allow create: if isSignedIn() && request.auth.uid == memberId;
        allow update: if isFamilyMember(familyId) && request.auth.uid == memberId;
        // Removing a caregiver (#55) is done by another current family
        // member, not by the removed member themselves — so delete can't be
        // gated on request.auth.uid == memberId the way update is. Revoking
        // access is just this: isFamilyMember(familyId) re-evaluates
        // exists() on every request, so deleting the doc immediately locks
        // the removed member out of every read/write gated by it — no
        // separate "access token" to invalidate.
        allow delete: if isFamilyMember(familyId);
      }

      // Invites are deliberately their own collection, not a member with a
      // pending flag — an invitee has no family access at all until they
      // accept and a real members/{uid} doc is created for them (#53).
      match /invites/{inviteId} {
        allow create: if isFamilyMember(familyId);
        // A family member sees every pending invite for their own family
        // (#54 — the Cuidadores screen lists them); the invitee themselves
        // can also read the one addressed to them before they're a member.
        allow read: if isFamilyMember(familyId) ||
          (isSignedIn() && request.auth.token.email == resource.data.email);
        // Accepting an invite (#53): only the invitee can update it, and only
        // to flip status to accepted — not to rewrite the email/invitedBy of
        // an invite that isn't theirs to redirect, or reopen an accepted one.
        allow update: if isSignedIn() &&
          request.auth.token.email == resource.data.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'accepted';
      }

      // BabyProfile, Activity (contractions/breastfeeding/pumping/diapers),
      // FoodIntroduction, Appointment — all nested under their family.
      match /{collection}/{documentId} {
        allow read, write: if isFamilyMember(familyId);
      }
    }
  }
}
