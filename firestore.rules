rules_version = '2';

// Starting point matching the data model in cuddly-app-directions.md
// (User/Family/Member/BabyProfile/Activity/...). Every family document is
// scoped to its members; nothing is readable/writable by anyone else.
// Review before this ever holds real user data — this has not been audited.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    // Who may create their own members/{uid} doc (#87): the family's founder
    // (createdBy, set once by createFamily.ts), or someone holding a pending
    // invite to this family for their own email — the member doc must name
    // that invite in inviteId. Anyone else, including a caregiver removed
    // via #55 who still knows the familyId, can't (re)join on their own.
    function isFounder(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.get('createdBy', null) == request.auth.uid;
    }

    function holdsPendingInvite(familyId) {
      let invite = get(/databases/$(database)/documents/families/$(familyId)/invites/$(request.resource.data.inviteId)).data;
      return invite.email == request.auth.token.email && invite.status == 'pending';
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Collection-group query support (#53): the nested match below already
    // secures get/create/update on families/{familyId}/invites/{inviteId},
    // but Firestore's rule-provability check for a `list`/collectionGroup
    // query needs a top-level {path=**} match to recognize and validate it
    // — the nested one alone isn't enough for that operation type.
    match /{path=**}/invites/{inviteId} {
      allow list: if isSignedIn() && request.auth.token.email == resource.data.email;
    }

    match /families/{familyId} {
      allow read, delete: if isFamilyMember(familyId);
      // createdBy decides who may bootstrap the first member doc (isFounder
      // above), so it's set by the creator and can never change afterwards —
      // otherwise a caregiver could make themselves "founder" before being
      // removed, then rejoin.
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamilyMember(familyId) &&
        request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);

      match /members/{memberId} {
        allow read: if isFamilyMember(familyId);
        // create can't be gated on isFamilyMember: that check requires the
        // member doc to already exist. Instead: only your own doc, and only
        // as the founder or with a pending invite (#87 — see isFounder /
        // holdsPendingInvite above).
        allow create: if isSignedIn() && request.auth.uid == memberId &&
          (isFounder(familyId) || holdsPendingInvite(familyId));
        allow update: if isFamilyMember(familyId) && request.auth.uid == memberId;
        // Removing a caregiver (#55) is done by another current family
        // member, not by the removed member themselves — so delete can't be
        // gated on request.auth.uid == memberId the way update is. Revoking
        // access is just this: isFamilyMember(familyId) re-evaluates
        // exists() on every request, so deleting the doc immediately locks
        // the removed member out of every read/write gated by it — no
        // separate "access token" to invalidate.
        allow delete: if isFamilyMember(familyId);
      }

      // Invites are deliberately their own collection, not a member with a
      // pending flag — an invitee has no family access at all until they
      // accept and a real members/{uid} doc is created for them (#53).
      match /invites/{inviteId} {
        allow create: if isFamilyMember(familyId);
        // A family member sees every pending invite for their own family
        // (#54 — the Cuidadores screen lists them); the invitee themselves
        // can also read the one addressed to them before they're a member.
        allow read: if isFamilyMember(familyId) ||
          (isSignedIn() && request.auth.token.email == resource.data.email);
        // Accepting an invite (#53): only the invitee can update it, and only
        // to flip status to accepted — not to rewrite the email/invitedBy of
        // an invite that isn't theirs to redirect, or reopen an accepted one.
        // Cancelling a pending invite, and account deletion wiping the
        // family (#69), are both done by a member.
        allow delete: if isFamilyMember(familyId);
        allow update: if isSignedIn() &&
          request.auth.token.email == resource.data.email &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
          request.resource.data.status == 'accepted';
      }

      // BabyProfile, Activity (contractions/breastfeeding/pumping/diapers),
      // FoodIntroduction, Appointment — all nested under their family.
      // members and invites are excluded (#87): Firestore grants access if
      // *any* matching rule allows it, so without this the wildcard would
      // override their stricter rules above for every family member (e.g.
      // editing another member's doc, or rewriting an invite's email).
      match /{collection}/{documentId} {
        allow read, write: if isFamilyMember(familyId) && !(collection in ['members', 'invites']);
      }
    }
  }
}
