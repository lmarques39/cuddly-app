# Copy this file to .env and fill in the values from the Firebase console:
# Project settings (gear icon) > General > Your apps > SDK setup and configuration.
# These are NOT secret — they identify the project to the client; real access
# control is enforced by Firestore/Auth security rules, not by hiding these.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# The *Firebase project's own* web OAuth client (project number 753146010921),
# the same one EAS uses — NOT the one shown under Authentication > Sign-in
# method > Google > Web SDK configuration, which belongs to another Google
# Cloud project. Native Android login only works with a web client from the
# same project as the Android client (#78); with the other one it fails with
# "[28444] Developer console is not set up correctly". Not secret.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=753146010921-2evddv13bbqvco0vu54887r3sj4c6gig.apps.googleusercontent.com

# Native Android Google login (#78) needs no env var: it uses the web client
# id above, plus an Android OAuth client (com.cuddlyapp.mobile + the SHA-1 of
# whichever keystore signed the build) that Firebase creates from the SHA-1s
# registered on the Android app. That's what google-services.json carries.
