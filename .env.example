# Copy this file to .env and fill in the values from the Firebase console:
# Project settings (gear icon) > General > Your apps > SDK setup and configuration.
# These are NOT secret — they identify the project to the client; real access
# control is enforced by Firestore/Auth security rules, not by hiding these.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# From Firebase console > Authentication > Sign-in method > Google > Web SDK
# configuration. Also not secret — the client secret shown alongside it stays
# in the Firebase console only, never in the app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Cloud Console > APIs & Services > Credentials > an OAuth client of
# type "Android", registered against com.cuddlyapp.mobile + the release
# keystore's SHA-1. Required on native Android: without it,
# expo-auth-session throws as soon as LoginScreen renders (see #77). Leave
# empty and "Continuar com Google" just disables itself on Android instead
# of crashing.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
